{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic.eval.transcript/v1alpha1",
  "title": "Agentic MCP replay transcript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "operations"],
  "properties": {
    "schema_version": { "const": "agentic.eval.transcript/v1alpha1" },
    "task_id": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "arguments", "expect_error"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "arguments": { "type": "object" },
          "expect_error": { "type": "boolean" }
        }
      }
    }
  }
}
