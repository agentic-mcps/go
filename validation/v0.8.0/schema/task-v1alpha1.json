{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic.eval.task/v1alpha1",
  "title": "Agentic evaluation task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "pilot", "repository", "prompt", "scope", "oracle", "acceptance", "invariants", "exercises"],
  "properties": {
    "schema_version": { "const": "agentic.eval.task/v1alpha1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "pilot": { "type": "boolean" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "base", "target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://github.com/" },
        "base": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "target": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "prompt": { "type": "string", "minLength": 20 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "packages", "allowed_paths"],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "packages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_paths"],
      "properties": {
        "overlay_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "timeout_seconds"],
        "properties": {
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 }
        }
      }
    },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "exercises": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
