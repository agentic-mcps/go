{
  "schema_version": "agentic.eval.task/v1alpha1",
  "id": "grpc-go-clone-token",
  "pilot": true,
  "repository": {
    "name": "grpc-go",
    "url": "https://github.com/grpc/grpc-go",
    "base": "3284af7e654993f7b9de31996ebc8fa81e375d8a",
    "target": "4793ad0474669eafbd5346c8a3d098fdfa542498"
  },
  "prompt": "Preserve all client transport-credential state when cloning ALTS credentials, including the bound access token, without changing server clone behavior.",
  "scope": {
    "workspace": ".",
    "packages": ["./credentials/alts"],
    "allowed_paths": ["credentials/alts/alts.go", "credentials/alts/alts_test.go"]
  },
  "oracle": { "overlay_paths": ["credentials/alts/alts_test.go"] },
  "acceptance": [
    { "argv": ["go", "test", "./credentials/alts", "-count=1"], "timeout_seconds": 180 }
  ],
  "invariants": [
    "Client clone preserves boundAccessToken, accounts, handshaker address, and server name.",
    "Server credential cloning remains unchanged."
  ],
  "exercises": ["symbol-context", "copy-semantics", "reverse-impact", "changed-coverage"]
}
