{
  "schema_version": "agentic.eval.task/v1alpha1",
  "id": "vault-malformed-approle-login",
  "pilot": false,
  "repository": {
    "name": "vault",
    "url": "https://github.com/hashicorp/vault",
    "base": "bca4b86d96a5f8e66cb1f7762c6ab84e2becd3d6",
    "target": "2b5390de051fac35593ad8a2664dbead4e4fec71"
  },
  "prompt": "Prevent malformed AppRole login data from causing a nil-pointer panic during login-alias inspection while preserving normal authentication behavior.",
  "scope": {
    "workspace": ".",
    "packages": ["./vault/external_tests/identity"],
    "allowed_paths": ["vault/core.go", "vault/external_tests/identity/approle_malformed_login_test.go"]
  },
  "oracle": { "overlay_paths": ["vault/external_tests/identity/approle_malformed_login_test.go"] },
  "acceptance": [
    { "argv": ["go", "test", "./vault/external_tests/identity", "-run", "^TestAppRole_MalformedLoginNoPanic$", "-count=1"], "timeout_seconds": 600 }
  ],
  "invariants": [
    "A malformed secret_id produces an error instead of a panic.",
    "The local Vault test server remains initialized and unsealed afterward.",
    "Valid login alias extraction remains unchanged."
  ],
  "exercises": ["security-boundary", "nil-safety", "cross-package-navigation", "error-flow"]
}
